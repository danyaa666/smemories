{
  "statusLine": {
    "type": "command",
    "command": "bash -c 'exec python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/statusline.py\"'",
    "refreshInterval": 60
  },
  "permissions": {
    "allow": [
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git show*)",
      "Bash(git fetch*)", "Bash(git add*)", "Bash(git commit*)", "Bash(git push*)",
      "Bash(git pull --ff-only*)", "Bash(git switch*)", "Bash(git checkout*)", "Bash(git branch*)",
      "Bash(git worktree*)", "Bash(git -C *)", "Bash(git ls-remote*)", "Bash(git rev-parse*)",
      "Bash(go build*)", "Bash(go test*)", "Bash(go vet*)", "Bash(go mod*)", "Bash(go get*)",
      "Bash(go run*)", "Bash(gofmt*)", "Bash(golangci-lint*)", "Bash(govulncheck*)",
      "Bash(npm ci*)", "Bash(npm install*)", "Bash(npm run *)", "Bash(npm test*)", "Bash(npm --prefix web *)",
      "Bash(docker compose *)", "Bash(make *)",
      "Bash(gh pr *)", "Bash(gh run *)", "Bash(gh repo view*)", "Bash(gh auth status*)",
      "CronCreate", "CronList", "CronDelete"
    ],
    "deny": [
      "Bash(git push --force*)", "Bash(git push -f*)", "Bash(git reset --hard origin*)",
      "Bash(rm -rf /*)", "Bash(rm -rf ~*)",
      "Read(./.env)", "Read(./.env.local)", "Read(./.env.production)", "Read(./.env.staging)"
    ]
  }
}
