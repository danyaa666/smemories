# Copy to .env for local development (.env is git-ignored). Dev-only values, no secrets.
# Load into your shell with: set -a; . ./.env; set +a
# Empty or unset variables fall back to the defaults shown here.

# Address the API listens on (host:port).
SMEM_HTTP_ADDR=:8080
# dev | test | prod
SMEM_ENV=dev
# debug | info | warn | error
SMEM_LOG_LEVEL=info

# --- Local stack (docker-compose.yml). Dev-only values: never reuse them anywhere real.
MYSQL_ROOT_PASSWORD=smem_root_dev
MYSQL_DATABASE=smemories
MYSQL_USER=smemories
MYSQL_PASSWORD=smem_dev_pw
# Host ports (loopback only). Change them here if something else already uses 3306/6379/9000/9001.
MYSQL_PORT=3306
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=smem_minio
MINIO_ROOT_PASSWORD=smem_minio_dev_pw
S3_BUCKET=smemories-dev

# --- API database. Required unless SMEM_ENV=test; keep host/port/user/password in step with the values above.
SMEM_DB_DSN=smemories:smem_dev_pw@tcp(127.0.0.1:3306)/smemories
# Connection pool (defaults shown).
SMEM_DB_MAX_OPEN=20
SMEM_DB_MAX_IDLE=5
SMEM_DB_CONN_MAX_LIFETIME=5m
# Integration tests (make test-integration) create smem_test_* databases through this account.
SMEM_TEST_DB_DSN=smemories:smem_dev_pw@tcp(127.0.0.1:3306)/smemories

# --- Redis-protocol store (Valkey from `make up`; sessions, email codes, rate limiters, D-23, docs/redis.md). Required in every
# environment. redis://[:password@]host:port/db, or rediss:// for TLS; keep the port in step with REDIS_PORT above.
SMEM_REDIS_URL=redis://127.0.0.1:6379/0
# Only when the URL carries no password (e.g. a token from a secret store).
# SMEM_REDIS_PASSWORD=
# Timeouts (defaults shown) and connection pool size.
SMEM_REDIS_DIAL_TIMEOUT=2s
SMEM_REDIS_READ_TIMEOUT=1s
SMEM_REDIS_WRITE_TIMEOUT=1s
SMEM_REDIS_POOL_SIZE=10
# Integration tests (make test-integration); every test uses its own key prefix.
SMEM_TEST_REDIS_URL=redis://127.0.0.1:6379/0

# --- Auth (T-006). Origins allowed to send cookie-carrying POST/PUT/PATCH/DELETE (CSRF check); required in prod.
SMEM_ALLOWED_ORIGINS=http://localhost:5173
# Where the web app lives; emailed links (verify, reset) are built from it. Required in prod (T-007).
SMEM_PUBLIC_BASE_URL=http://localhost:5173
# Deadline of every request context (minimum 1s); a route may set its own.
SMEM_HTTP_REQUEST_TIMEOUT=30s
# Behind a trusted proxy/load balancer only: take the client IP from the last X-Forwarded-For hop.
SMEM_TRUST_PROXY=false
# Concurrent argon2id hashes (each uses ~19 MiB) and cost parameters (defaults shown).
SMEM_AUTH_MAX_CONCURRENT_HASHES=4
SMEM_AUTH_ARGON_MEMORY_KIB=19456
SMEM_AUTH_ARGON_TIME=2
SMEM_AUTH_ARGON_PARALLELISM=1
# Rate limits (defaults shown): registrations per IP per hour; failed logins per IP+email and per IP per 15 minutes.
SMEM_RATE_REGISTER_PER_HOUR=5
SMEM_RATE_LOGIN_FAILS_PER_EMAIL=10
SMEM_RATE_LOGIN_FAILS_PER_IP=100

# --- Google sign-in (T-011), optional. Setting the client id turns it on and then all of these are required (README, "Google sign-in setup").
# SMEM_GOOGLE_CLIENT_ID=
# SMEM_GOOGLE_CLIENT_SECRET=
# At least 32 random bytes signing the short-lived smem_oidc cookie, e.g. `openssl rand -base64 48`.
# SMEM_OIDC_COOKIE_KEY=
# Default https://accounts.google.com
# SMEM_GOOGLE_ISSUER=
# --- Photo uploads (T-009). The S3 values below point at the local MinIO from `make up`; in production leave
# SMEM_S3_ENDPOINT empty (AWS S3) and set the real bucket and keys. Keep keys/bucket in step with MINIO_*/S3_BUCKET above.
SMEM_S3_ENDPOINT=http://127.0.0.1:9000
SMEM_S3_REGION=us-east-1
SMEM_S3_BUCKET=smemories-dev
SMEM_S3_ACCESS_KEY=smem_minio
SMEM_S3_SECRET_KEY=smem_minio_dev_pw
SMEM_S3_PATH_STYLE=true
# Largest accepted upload in bytes (default 10 MiB) and how many images are decoded at once (default 2;
# each can need several hundred MiB, see docs/media.md).
SMEM_MEDIA_MAX_BYTES=10485760
SMEM_MEDIA_MAX_CONCURRENT=2
# Public note submissions (T-034) are spooled to disk while they arrive. At most this many in progress at once (default 48,
# worst case that many x 32 MiB of disk), of which one client IP may have SMEM_PUBLIC_UPLOAD_CONCURRENT_PER_IP (default 8);
# above that: 503 busy. SMEM_UPLOAD_TMP_DIR is the directory for the spool files (default: the OS temp dir).
SMEM_PUBLIC_UPLOAD_MAX_CONNS=48
SMEM_PUBLIC_UPLOAD_CONCURRENT_PER_IP=8
# SMEM_UPLOAD_TMP_DIR=
# Soft memory limit of the Go runtime in MiB (0 = unset). In a container set it to about 75% of the task memory.
SMEM_MEMORY_LIMIT_MIB=0
