# Copy to .env for local development (.env is git-ignored). Dev-only values, no secrets.
# Load into your shell with: set -a; . ./.env; set +a
# Empty or unset variables fall back to the defaults shown here.

# Address the API listens on (host:port).
SMEM_HTTP_ADDR=:8080
# dev | test | prod
SMEM_ENV=dev
# debug | info | warn | error
SMEM_LOG_LEVEL=info

# --- Local stack (docker-compose.yml). Dev-only values: never reuse them anywhere real.
MYSQL_ROOT_PASSWORD=smem_root_dev
MYSQL_DATABASE=smemories
MYSQL_USER=smemories
MYSQL_PASSWORD=smem_dev_pw
# Host ports (loopback only). Change them here if something else already uses 3306/9000/9001.
MYSQL_PORT=3306
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=smem_minio
MINIO_ROOT_PASSWORD=smem_minio_dev_pw
S3_BUCKET=smemories-dev

# --- API database. Required unless SMEM_ENV=test; keep host/port/user/password in step with the values above.
SMEM_DB_DSN=smemories:smem_dev_pw@tcp(127.0.0.1:3306)/smemories
# Connection pool (defaults shown).
SMEM_DB_MAX_OPEN=20
SMEM_DB_MAX_IDLE=5
SMEM_DB_CONN_MAX_LIFETIME=5m
# Integration tests (make test-integration) create smem_test_* databases through this account.
SMEM_TEST_DB_DSN=smemories:smem_dev_pw@tcp(127.0.0.1:3306)/smemories

# --- Auth (T-006). Origins allowed to send cookie-carrying POST/PUT/PATCH/DELETE (CSRF check); required in prod.
SMEM_ALLOWED_ORIGINS=http://localhost:5173
# Behind a trusted proxy/load balancer only: take the client IP from the last X-Forwarded-For hop.
SMEM_TRUST_PROXY=false
# Concurrent argon2id hashes (each uses ~19 MiB) and cost parameters (defaults shown).
SMEM_AUTH_MAX_CONCURRENT_HASHES=4
SMEM_AUTH_ARGON_MEMORY_KIB=19456
SMEM_AUTH_ARGON_TIME=2
SMEM_AUTH_ARGON_PARALLELISM=1
# Rate limits (defaults shown): registrations per IP per hour; failed logins per IP+email and per IP per 15 minutes.
SMEM_RATE_REGISTER_PER_HOUR=5
SMEM_RATE_LOGIN_FAILS_PER_EMAIL=10
SMEM_RATE_LOGIN_FAILS_PER_IP=100

# --- Photo uploads (T-009). The S3 values below point at the local MinIO from `make up`; in production leave
# SMEM_S3_ENDPOINT empty (AWS S3) and set the real bucket and keys. Keep keys/bucket in step with MINIO_*/S3_BUCKET above.
SMEM_S3_ENDPOINT=http://127.0.0.1:9000
SMEM_S3_REGION=us-east-1
SMEM_S3_BUCKET=smemories-dev
SMEM_S3_ACCESS_KEY=smem_minio
SMEM_S3_SECRET_KEY=smem_minio_dev_pw
SMEM_S3_PATH_STYLE=true
# Largest accepted upload in bytes (default 10 MiB) and how many images are decoded at once (default 4).
SMEM_MEDIA_MAX_BYTES=10485760
SMEM_MEDIA_MAX_CONCURRENT=4
