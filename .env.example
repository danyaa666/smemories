# Copy to .env for local development (.env is git-ignored). Dev-only values, no secrets.
# Load into your shell with: set -a; . ./.env; set +a
# Empty or unset variables fall back to the defaults shown here.

# Address the API listens on (host:port).
SMEM_HTTP_ADDR=:8080
# dev | test | prod
SMEM_ENV=dev
# debug | info | warn | error
SMEM_LOG_LEVEL=info
