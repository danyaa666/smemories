{
  "info": {
    "name": "SMemories - auth",
    "description": "Email + password auth core (T-006): register, login, logout, /v1/me. Run against an API started with SMEM_ENV=dev (the session cookie is not Secure there, so Newman's cookie jar sends it over http). Register is limited to 5 per hour per IP and each run makes 2 counted attempts (the register and the duplicate), so a third run within the hour gets 429: restart the API (in-memory limits) or set SMEM_RATE_REGISTER_PER_HOUR higher. The 429 and 503 paths are covered by the Go integration tests, not here.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "origin",
      "value": "http://localhost:5173"
    }
  ],
  "item": [
    {
      "name": "Full flow",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Folder scripts run before every request in the folder, so generate only before the first one: the whole flow then",
              "// uses one consistent account, and every new run of the folder gets a fresh one (no collision with old data).",
              "if (pm.info.requestName.startsWith('1. ')) {",
              "const n = Date.now() + '-' + Math.floor(Math.random() * 1e6);",
              "pm.collectionVariables.set('email', 'newman-' + n + '@example.com');",
              "pm.collectionVariables.set('emailUpper', 'NEWMAN-' + n + '@EXAMPLE.COM');",
              "pm.collectionVariables.set('password', 'Fake-Newman-pw-' + n);",
              "pm.collectionVariables.set('displayName', 'Newman Tester Đặng 🎓');",
              "}"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "1. Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{email}}\", \"password\": \"{{password}}\", \"display_name\": \"{{displayName}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"user object is exactly the 6 documented fields\", () => { const u = pm.response.json().user; pm.expect(Object.keys(u).sort()).to.eql([\"created_at\",\"display_name\",\"email\",\"email_verified\",\"id\",\"locale\"]); pm.expect(u.id).to.match(/^[0-9A-HJKMNP-TV-Z]{26}$/); pm.expect(u.email_verified).to.eql(false); pm.expect(u.locale).to.eql(\"en\"); });",
                  "pm.test(\"no password or hash in the body\", () => pm.expect(pm.response.text().toLowerCase()).to.not.match(/password|argon|hash/));",
                  "pm.test(\"session cookie flags\", () => { const c = pm.response.headers.get(\"Set-Cookie\") || \"\"; pm.expect(c).to.include(\"smem_session=\"); pm.expect(c).to.include(\"HttpOnly\"); pm.expect(c).to.include(\"SameSite=Lax\"); pm.expect(c).to.include(\"Path=/\"); pm.expect(c).to.include(\"Max-Age=2592000\"); });",
                  "pm.test(\"email and display name\", () => { const u = pm.response.json().user; pm.expect(u.email).to.eql(pm.collectionVariables.get(\"email\")); pm.expect(u.display_name).to.eql(pm.collectionVariables.get(\"displayName\")); });",
                  "pm.collectionVariables.set(\"userId\", pm.response.json().user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Who am I (cookie from register)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"user object is exactly the 6 documented fields\", () => { const u = pm.response.json().user; pm.expect(Object.keys(u).sort()).to.eql([\"created_at\",\"display_name\",\"email\",\"email_verified\",\"id\",\"locale\"]); pm.expect(u.id).to.match(/^[0-9A-HJKMNP-TV-Z]{26}$/); pm.expect(u.email_verified).to.eql(false); pm.expect(u.locale).to.eql(\"en\"); });",
                  "pm.test(\"same user\", () => pm.expect(pm.response.json().user.id).to.eql(pm.collectionVariables.get(\"userId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{origin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "logout"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 204\", () => pm.response.to.have.status(204));",
                  "pm.test(\"cookie cleared\", () => { const c = pm.response.headers.get(\"Set-Cookie\") || \"\"; pm.expect(c).to.include(\"smem_session=;\"); pm.expect(c).to.match(/Max-Age=0|Max-Age=-|Expires=Thu, 01 Jan 1970/); });"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Who am I after logout -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"error code unauthenticated\", () => pm.expect(pm.response.json().error.code).to.eql(\"unauthenticated\"));",
                  "pm.test(\"error envelope with request id\", () => { const e = pm.response.json().error; pm.expect(e.code).to.be.a(\"string\"); pm.expect(e.request_id).to.eql(pm.response.headers.get(\"X-Request-Id\")); });"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Login (email in another case)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{emailUpper}}\", \"password\": \"{{password}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"user object is exactly the 6 documented fields\", () => { const u = pm.response.json().user; pm.expect(Object.keys(u).sort()).to.eql([\"created_at\",\"display_name\",\"email\",\"email_verified\",\"id\",\"locale\"]); pm.expect(u.id).to.match(/^[0-9A-HJKMNP-TV-Z]{26}$/); pm.expect(u.email_verified).to.eql(false); pm.expect(u.locale).to.eql(\"en\"); });",
                  "pm.test(\"no password or hash in the body\", () => pm.expect(pm.response.text().toLowerCase()).to.not.match(/password|argon|hash/));",
                  "pm.test(\"session cookie flags\", () => { const c = pm.response.headers.get(\"Set-Cookie\") || \"\"; pm.expect(c).to.include(\"smem_session=\"); pm.expect(c).to.include(\"HttpOnly\"); pm.expect(c).to.include(\"SameSite=Lax\"); pm.expect(c).to.include(\"Path=/\"); pm.expect(c).to.include(\"Max-Age=2592000\"); });",
                  "pm.test(\"same user id\", () => pm.expect(pm.response.json().user.id).to.eql(pm.collectionVariables.get(\"userId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Who am I after login",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"user object is exactly the 6 documented fields\", () => { const u = pm.response.json().user; pm.expect(Object.keys(u).sort()).to.eql([\"created_at\",\"display_name\",\"email\",\"email_verified\",\"id\",\"locale\"]); pm.expect(u.id).to.match(/^[0-9A-HJKMNP-TV-Z]{26}$/); pm.expect(u.email_verified).to.eql(false); pm.expect(u.locale).to.eql(\"en\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Logout again (idempotent), then once more without a session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{origin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "logout"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
