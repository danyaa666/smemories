{
  "info": {
    "name": "SMemories - platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /healthz",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 ok\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.eql({status:\"ok\"}); });",
                  "pm.test(\"security headers\", () => { pm.expect(pm.response.headers.get(\"X-Content-Type-Options\")).to.eql(\"nosniff\"); pm.expect(pm.response.headers.get(\"Referrer-Policy\")).to.eql(\"no-referrer\"); pm.expect(pm.response.headers.get(\"X-Frame-Options\")).to.eql(\"DENY\"); pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "healthz"
              ]
            }
          }
        },
        {
          "name": "GET /healthz reuses a valid X-Request-Id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"id echoed\", () => pm.expect(pm.response.headers.get(\"X-Request-Id\")).to.eql(\"postman-req-0001\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-Id",
                "value": "postman-req-0001"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "healthz"
              ]
            }
          }
        },
        {
          "name": "GET /healthz replaces an invalid X-Request-Id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"id regenerated\", () => { const id = pm.response.headers.get(\"X-Request-Id\"); pm.expect(id).to.not.eql(\"bad id\"); pm.expect(id).to.match(/^[A-Za-z0-9-]{8,64}$/); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-Id",
                "value": "bad id"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "healthz"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Edge cases",
      "item": [
        {
          "name": "GET unknown path -> 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404 not_found\", () => { pm.response.to.have.status(404); pm.expect(pm.response.json().error.code).to.eql(\"not_found\"); });",
                  "const j = pm.response.json();",
                  "pm.test(\"error envelope\", () => { pm.expect(j.error.code).to.be.a(\"string\"); pm.expect(j.error.message).to.be.a(\"string\"); pm.expect(j.error.request_id).to.eql(pm.response.headers.get(\"X-Request-Id\")); });",
                  "pm.test(\"security headers\", () => { pm.expect(pm.response.headers.get(\"X-Content-Type-Options\")).to.eql(\"nosniff\"); pm.expect(pm.response.headers.get(\"Referrer-Policy\")).to.eql(\"no-referrer\"); pm.expect(pm.response.headers.get(\"X-Frame-Options\")).to.eql(\"DENY\"); pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/does-not-exist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "does-not-exist"
              ]
            }
          }
        },
        {
          "name": "POST /healthz -> 405",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"405 method_not_allowed + Allow\", () => { pm.response.to.have.status(405); pm.expect(pm.response.json().error.code).to.eql(\"method_not_allowed\"); pm.expect(pm.response.headers.get(\"Allow\")).to.include(\"GET\"); });",
                  "const j = pm.response.json();",
                  "pm.test(\"error envelope\", () => { pm.expect(j.error.code).to.be.a(\"string\"); pm.expect(j.error.message).to.be.a(\"string\"); pm.expect(j.error.request_id).to.eql(pm.response.headers.get(\"X-Request-Id\")); });",
                  "pm.test(\"security headers\", () => { pm.expect(pm.response.headers.get(\"X-Content-Type-Options\")).to.eql(\"nosniff\"); pm.expect(pm.response.headers.get(\"Referrer-Policy\")).to.eql(\"no-referrer\"); pm.expect(pm.response.headers.get(\"X-Frame-Options\")).to.eql(\"DENY\"); pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "healthz"
              ]
            }
          }
        }
      ]
    }
  ]
}
