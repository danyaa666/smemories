# T-186: a local Linux box for print-check that matches the CI runner (ubuntu-24.04, Playwright 1.64.0 with its OS fonts, poppler).
# Used by scripts/print-check-linux.sh; keep the Playwright tag equal to tools/print-check/package.json.
FROM mcr.microsoft.com/playwright:v1.64.0-noble
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends poppler-utils && rm -rf /var/lib/apt/lists/*
